# Browser-safe variables (Vite — shipped to the client).
# Copy to .env

# Keep true until packageId + parties are wired and smoke test is green.
VITE_USE_MOCKS=true

# Five North sandbox JSON Ledger API v2 REST base (used by Vite /api/ledger proxy + CLI scripts)
VITE_CANTON_LEDGER_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io

# Browser uses /api/ledger proxy by default (avoids CORS). Set false only if you have direct CORS access.
# VITE_LEDGER_PROXY=false

# WebSocket base (subprotocol auth — see src/ledger/ws.ts)
VITE_CANTON_LEDGER_WS_URL=wss://ledger-api.validator.devnet.sandbox.fivenorth.io

# Ledger API userId for JsCommands (when submitting commands later)
VITE_CANTON_USER_ID=ledger-api-user

# Full Canton party IDs — filled by: npm run allocate:parties
# VITE_PARTY_SME=
# VITE_PARTY_DEBTOR=
# VITE_PARTY_LENDER_A=
# VITE_PARTY_LENDER_B=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — do NOT prefix with VITE_
# Copy to .env.server (gitignored). Used by POST /api/token and npm run smoke:ledger
# ---------------------------------------------------------------------------
#
# CANTON_AUTH_TOKEN_URL=https://auth.sandbox.fivenorth.io/application/o/token/
# CANTON_CLIENT_ID=validator-devnet-m2m
# CANTON_CLIENT_SECRET=<your-secret-from-five-north>
# CANTON_TOKEN_AUDIENCE=validator-devnet-m2m
# CANTON_TOKEN_SCOPE=daml_ledger_api
# CANTON_LEDGER_REST_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io
#
# The frontend never sees CANTON_CLIENT_SECRET. It calls POST /api/token on the
# dev server, which performs client_credentials exchange server-side.
