# Copy to .env and fill in after Canton participant is running.
# VITE_USE_MOCKS=true keeps the UI on local mock data (default for development).

VITE_USE_MOCKS=true

# JSON Ledger API v2 base URL (participant node, default port 7575).
# Example: http://localhost:7575
VITE_CANTON_LEDGER_URL=http://localhost:7575

# JWT bearer token with rights to act as your application parties.
# Obtain from your Canton auth / token issuer.
VITE_CANTON_TOKEN=

# Ledger API userId (optional if encoded in JWT; required by JsCommands).
VITE_CANTON_USER_ID=ledger-api-user
