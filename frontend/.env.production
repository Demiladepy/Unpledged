# Committed production config for `vite build` (Vercel).
# Only PUBLIC, browser-safe values belong here — these are baked into the
# client bundle at build time. The OAuth client secret is NOT here; it lives
# in Vercel's server env vars (CANTON_CLIENT_SECRET) for the /api proxies.
#
# Party IDs and the DevNet URL are public on-ledger identifiers, not secrets.
# Local `npm run dev` still uses `.env` (development mode), so this file only
# affects production builds.

VITE_USE_MOCKS=false
VITE_CANTON_LEDGER_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io
VITE_CANTON_LEDGER_WS_URL=wss://ledger-api.validator.devnet.sandbox.fivenorth.io
VITE_CANTON_USER_ID=6
VITE_PARTY_SME=SME::1220a14ca128063b8dc9d1ebb0bd22633be9f2168500f4dbc1ecaeb1855b14e5acf8
VITE_PARTY_DEBTOR=Debtor::1220a14ca128063b8dc9d1ebb0bd22633be9f2168500f4dbc1ecaeb1855b14e5acf8
VITE_PARTY_LENDER_A=LenderA::1220a14ca128063b8dc9d1ebb0bd22633be9f2168500f4dbc1ecaeb1855b14e5acf8
VITE_PARTY_LENDER_B=LenderB::1220a14ca128063b8dc9d1ebb0bd22633be9f2168500f4dbc1ecaeb1855b14e5acf8
