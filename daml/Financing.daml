module Financing where

import Attestation
import Invoice

-- Marks a specific invoice (identified by its canonical, debtor-attested ref) as
-- pledged to a lender. The lender is never made a stakeholder of the Invoice.
--
-- Double-pledge prevention (LF 2.x — contract keys unavailable): PledgeRegistry
-- tracks pledged refs per SME; RecordPledge rejects duplicate invoiceRef.
--
-- Privacy (defense-in-depth): Invoice is never fetched inside any action the
-- lender informees. PreparePledge runs under FinancingCoordinator (SME-only root
-- informee); AcceptFinancing fetches only the attestation and PledgeIntent.

template PledgeRegistry
  with
    owner : Party
    pledgedRefs : [Text]
  where
    signatory owner

    choice RecordPledge : ContractId PledgeMarker
      with
        lender : Party
        invoiceRef : Text
      controller owner
      do
        assertMsg "Invoice already pledged" (invoiceRef `notElem` pledgedRefs)
        _ <- create PledgeRegistry with
          owner
          pledgedRefs = invoiceRef :: pledgedRefs
        create PledgeMarker with
          invoiceOwner = owner
          lender
          invoiceRef

template PledgeMarker
  with
    invoiceOwner : Party
    lender : Party
    invoiceRef : Text
  where
    signatory invoiceOwner
    observer lender

template FinancingOffer
  with
    lender : Party
    sme : Party
    attestationCid : ContractId UnpledgedAttestation
    advanceAmount : Decimal
  where
    signatory lender
    observer sme

    ensure advanceAmount > 0.0

    choice AcceptFinancing : ContractId PledgeMarker
      with
        pledgeIntentCid : ContractId PledgeIntent
        pledgeRegistryCid : ContractId PledgeRegistry
      controller sme
      do
        attestation <- fetch attestationCid
        assertMsg "Attestation lender mismatch" (attestation.lender == lender)
        assertMsg "Attestation SME mismatch" (attestation.owner == sme)
        intent <- fetch pledgeIntentCid
        assertMsg "PledgeIntent owner mismatch" (intent.invoiceOwner == sme)
        markerCid <-
          exercise pledgeRegistryCid RecordPledge with
            lender
            invoiceRef = intent.invoiceRef
        archive pledgeIntentCid
        pure markerCid

template FinancingCoordinator
  with
    sme : Party
  where
    signatory sme

    nonconsuming choice CompleteFinancing : ContractId PledgeMarker
      with
        invoiceCid : ContractId Invoice
        offerCid : ContractId FinancingOffer
        pledgeRegistryCid : ContractId PledgeRegistry
      controller sme
      do
        pledgeIntentCid <- exercise invoiceCid PreparePledge
        exercise offerCid AcceptFinancing with
          pledgeIntentCid
          pledgeRegistryCid
